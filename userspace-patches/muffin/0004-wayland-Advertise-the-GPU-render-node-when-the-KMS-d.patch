           g_warning ("DMABUF: primary device path = %s (render node %s)",
diff --git a/src/wayland/meta-wayland-drm.c b/src/wayland/meta-wayland-drm.c
index 12f3f024..9a4ea74a 100644
--- a/src/wayland/meta-wayland-drm.c
+++ b/src/wayland/meta-wayland-drm.c
@@ -21,6 +21,8 @@
 
 #include "wayland/meta-wayland-drm.h"
 
+#include <string.h>
+#include <stdlib.h>
 #include <xf86drm.h>
 
 #include "backends/meta-backend-private.h"
@@ -114,6 +116,52 @@ drm_bind (struct wl_client *client,
   wl_drm_send_capabilities (resource, WL_DRM_CAPABILITY_PRIME);
 }
 
+/*
+ * On many ARM SoCs the display controller (the KMS device muffin drives, e.g.
+ * sun4i-drm, rockchip, meson) and the GPU (panfrost, lima, etnaviv...) are
+ * separate DRM devices: the KMS device has no render node and rendering goes
+ * through Mesa's kmsro/renderonly layer. drmGetRenderDeviceNameFromFd() then
+ * returns NULL, so we'd advertise nothing (or the card node), Mesa clients
+ * can't find a GPU and silently fall back to llvmpipe. In that case advertise
+ * the render node of the GPU instead: the lowest-numbered render node, which
+ * is the first GPU the kernel registered.
+ */
+char *
+meta_wayland_drm_find_render_node (int kms_fd)
+{
+  drmDevicePtr devices[64];
+  char *render_node;
+  int n, i, best = -1;
+
+  render_node = drmGetRenderDeviceNameFromFd (kms_fd);
+  if (render_node)
+    return render_node;
+
+  n = drmGetDevices2 (0, devices, G_N_ELEMENTS (devices));
+  if (n <= 0)
+    return NULL;
+
+  for (i = 0; i < n; i++)
+    {
+      if (!(devices[i]->available_nodes & (1 << DRM_NODE_RENDER)))
+        continue;
+      if (best < 0 ||
+          strcmp (devices[i]->nodes[DRM_NODE_RENDER],
+                  devices[best]->nodes[DRM_NODE_RENDER]) < 0)
+        best = i;
+    }
+
+  if (best >= 0)
+    {
+      render_node = strdup (devices[best]->nodes[DRM_NODE_RENDER]);
+      g_message ("KMS device has no render node (display-only controller); "
+                 "using GPU render node %s", render_node);
+    }
+
+  drmFreeDevices (devices, n);
+  return render_node;
+}
+
 void
 meta_wayland_drm_init (MetaWaylandCompositor *compositor)
 {
@@ -129,7 +177,7 @@ meta_wayland_drm_init (MetaWaylandCompositor *compositor)
 
   gpu_kms = META_GPU_KMS (gpus->data);
   kms_fd = meta_gpu_kms_get_fd (gpu_kms);
-  render_node_path = drmGetRenderDeviceNameFromFd (kms_fd);
+  render_node_path = meta_wayland_drm_find_render_node (kms_fd);
 
   if (!render_node_path)
     {
diff --git a/src/wayland/meta-wayland-drm.h b/src/wayland/meta-wayland-drm.h
index 23caa2ab..b72b43c5 100644
--- a/src/wayland/meta-wayland-drm.h
+++ b/src/wayland/meta-wayland-drm.h
@@ -24,4 +24,9 @@
 
 void meta_wayland_drm_init (MetaWaylandCompositor *compositor);
 
+/* Render node to advertise to clients for the GPU behind kms_fd. Falls back
+ * to the system's render node when the KMS device has none (display-only
+ * controllers on ARM SoCs, rendered through kmsro/renderonly). Free with free(). */
+char * meta_wayland_drm_find_render_node (int kms_fd);
+
 #endif /* META_WAYLAND_DRM_H */
