/dts-v1/;

#include "sun55i-a523.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "OrangePi 4A";
	compatible = "xunlong,orangepi-4a", "allwinner,sun55i-t527";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:115200n8";

		/*
		 * Display stage A: HDMI console via SIMPLEDRM using the FB that the
		 * vendor U-Boot leaves painted (logo), with the DE still scanning out after
		 * bootm. Address/size VERIFIED LIVE 2026-07-08: it is the
		 * memreserve that sunxi_drm_kernel_para_flush() adds to the FDT
		 * (/sys/firmware/fdt of the running 6.18): 0xbbea2000 + 0x3fc000
		 * = 5440 (stride) x 768 -> 1360x768 32bpp. NOTE: U-Boot picks the mode
		 * from the connected monitor; if the monitor changes,
		 * re-check against the memreserve in the live FDT. The real format is
		 * ARGB8888 (fb0 on 5.15); we declare x8r8g8b8 (same layout)
		 * so that DRM does not assume alpha blending.
		 */
		framebuffer@bbea2000 {
			compatible = "simple-framebuffer";
			reg = <0x0 0xbbea2000 0x0 0x003fc000>;
			memory-region = <&uboot_fb>;
			width = <1360>;
			height = <768>;
			stride = <5440>;
			format = "x8r8g8b8";
			/*
			 * Claim the display pipeline power domains that U-Boot left
			 * powered on. Without this, as soon as ALL the
			 * pck600 consumers have probed (e.g. panfrost as a
			 * module), its sync_state() sweeps the domains with no
			 * consumer and powers DE and VO0 off -> black screen half-way
			 * through boot (seen live 2026-07-08: DE/VO0 off-0 in
			 * pm_genpd_summary tras modprobe panfrost). simpledrm
			 * supports multiple power-domains and keeps them on.
			 */
			power-domains = <&pck600 PD_DE>, <&pck600 PD_VO0>;
		};
	};

	/*
	 * The vendor U-Boot (v2018.05-t527) does NOT fill in /memory (it assumes the DTB
	 * already carries it, like the vendor one). The mainline DTB left it empty -> the kernel
	 * boots without knowing where the RAM is -> instant silent hang, no
	 * heartbeat. Define a static /memory like the vendor DTB: base 0x40000000.
	 * (On a 2GB board use size 0x80000000 instead of 0x1 0x0.)
	 */
	memory@40000000 {
		device_type = "memory";
		/* OPi4A 2GB: base 0x40000000, size 0x80000000 (2 GiB) */
		reg = <0x0 0x40000000 0x0 0x80000000>;
	};

	/*
	 * The 5.15 BSP reserves this region for BL31 (ARM Trusted Firmware),
	 * the EL3 secure monitor that serves ALL PSCI calls (SMP core
	 * bring-up, idle, reset). The mainline DTB reserved nothing and its
	 * /memory (2GB from 0x40000000) covers 0x48000000 -> the kernel sees those
	 * 16 MB as free RAM, allocates pages there and OVERWRITES BL31. SMP
	 * starts before the heartbeat (BL31 still intact) -> 1 beat; right
	 * after that a PSCI call lands in corrupted code -> hang with the LED
	 * stuck. Reserving the region (like the BSP does) avoids it. no-map = the
	 * kernel does not even map it. The vendor U-Boot v2018 does not inject this
	 * reservation into a foreign DTB, so it has to be static here.
	 */
	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * The vendor firmware (BL31 + OP-TEE + shared memory) uses SEVERAL
		 * regions that the vendor U-Boot reserves in the 5.15 FDT but NOT in
		 * our foreign DTB. Taken from /proc/iomem of the running 5.15. Reserving
		 * ONLY bl31 let the kernel overwrite OP-TEE/shm -> hang after
		 * 2 beats. Reserve all 4 (like the BSP).
		 */
		/*
		 * no-map on all four: without it they stay in the linear map and a
		 * SPECULATIVE CPU read of RAM protected by the
		 * secure firewall can raise sporadic SErrors even though the
		 * kernel never allocates them.
		 */
		sec-sram1@42350000 {
			reg = <0x0 0x42350000 0x0 0x00230000>;
			no-map;
		};

		sec-sram2@43000000 {
			reg = <0x0 0x43000000 0x0 0x00094000>;
			no-map;
		};

		bl31@48000000 {
			reg = <0x0 0x48000000 0x0 0x01000000>;
			no-map;
		};

		optee@4941d000 {
			reg = <0x0 0x4941d000 0x0 0x00be3000>;
			no-map;
		};

		/*
		 * U-Boot FB for the simple-framebuffer node in /chosen (see the
		 * comment there). U-Boot already adds a plain memreserve for this
		 * region, but that leaves it in the linear map, and on arm64 both
		 * memremap(WC) and ioremap_wc FAIL on mapped RAM ->
		 * simpledrm could not map it. no-map is MANDATORY.
		 */
		uboot_fb: framebuffer@bbea2000 {
			reg = <0x0 0xbbea2000 0x0 0x003fc000>;
			no-map;
		};
	};

	/*
	 * Stub nodes for the vendor U-Boot (v2018.05-t527): its bootm calls
	 * sunxi_drm_kernel_para_flush(), which looks up /soc/sunxi-drm and /soc/de in the
	 * FDT to inject its display parameters. The mainline DTB does not have
	 * them -> the fixup half-fails and corrupts the FDT -> the kernel hangs.
	 * With these empty nodes the fixup completes without error; the mainline kernel
	 * ignores them (no compatible). Do NOT touch U-Boot: the 5.15 BSP needs
	 * esas inyecciones.
	 */
	soc {
		sunxi-drm {
		};

		de {
		};
	};

	ext_osc32k: ext-osc32k-clk {
		#clock-cells = <0>;
		compatible = "fixed-clock";
		clock-frequency = <32768>;
		clock-output-names = "ext_osc32k";
	};

	leds {
		compatible = "gpio-leds";

		/* PWM capable pin, but PWM isn't supported yet. */
		led {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&pio 3 20 GPIO_ACTIVE_HIGH>; /* PD20 */
			linux,default-trigger = "heartbeat";
		};
	};

	iio-hwmon {
		compatible = "iio-hwmon";
		io-channels = <&axp717_adc 3>, /* vsys_v */
			      <&axp717_adc 4>, /* pmic_temp */
			      <&axp717_adc 7>; /* bkup_batt_v */
	};

	wifi_pwrseq: pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&r_pio 1 1 GPIO_ACTIVE_LOW>; /* PM1 */
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "ext_clock";
	};

	reg_otg_vbus: regulator-otg-vbus {
		compatible = "regulator-fixed";
		regulator-name = "otg-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_vcc5v>;
		gpio = <&r_pio 0 4 GPIO_ACTIVE_HIGH>;	/* PL4 */
		enable-active-high;
		/*
		 * PL4 feeds the VBUS of port usbc0 (the 2 rear left
		 * USB-A ports). With no ID/CC pin, the OTG driver never got to enable
		 * VBUS -> those 2 ports stayed dead (otg-vbus=disabled).
		 * dr_mode=host: always-on is right for a
		 * host-only port. Confirmed on the board 2026-07-13: all 4 rear ports work.
		 */
		regulator-always-on;
	};

	reg_pcie_vcc3v3: regulator-pcie-vcc3v3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc-pcie-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&reg_vcc5v>;
		gpio = <&r_pio 0 8 GPIO_ACTIVE_HIGH>;	/* PL8 */
		enable-active-high;
	};

	reg_usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&reg_vcc5v>;
		gpio = <&r_pio 0 12 GPIO_ACTIVE_HIGH>;	/* PL12 */
		enable-active-high;
	};

	reg_vcc5v: regulator-vcc5v {
		/* board wide 5V supply from USB type-C port */
		compatible = "regulator-fixed";
		regulator-name = "vcc-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
	};
};

/ {
	/*
	 * OPP tables, voltages taken verbatim from the vendor DT
	 * (sun55iw3p1.dtsi), using the worst-case voltage across speed bins
	 * for each frequency so a plain cpufreq-dt (no speed-bin nvmem) is
	 * safe on any chip. Both clusters run to their vendor maximums for
	 * this board's silicon: little 1.416 GHz, big 1.8 GHz (see the speed
	 * bin note in the cluster1 table; 1.992 GHz exists only for bin
	 * vf0400 and needs 1.22 V, beyond this rail's 1.15 V maximum).
	 *
	 * The lowest point is 480 MHz instead of the vendor's 408 MHz: the
	 * CPU PLLs are modelled as plain 24 MHz * N (N >= 20, post-divider
	 * left at /1 by the firmware), so 480 MHz is the real floor. Its
	 * 0.90 V sits within the vendor envelope (408 and 672 MHz both run
	 * at 0.90 V on every speed bin).
	 */
	/*
	 * DCDC1 (vdd-cpul) does not power this cluster alone: the DSU (the
	 * DynamIQ Shared Unit, i.e. the coherent interconnect and the shared
	 * L3) hangs off the very same rail. Each OPP therefore declares a
	 * range instead of an exact voltage. opp_parse_supplies() turns a
	 * single value into u_volt_min == u_volt_max, and with that
	 * regulator_check_consumers() aggregates to min > max and fails the
	 * transition with -EINVAL the moment the other consumer of the rail
	 * asks for a different voltage. The upper bound is 1.15 V, the
	 * highest voltage the vendor tables ever put on this rail.
	 */
	cluster0_opp: opp-table-cluster0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-480000000 {
			opp-hz = /bits/ 64 <480000000>;
			opp-microvolt = <900000 900000 1150000>;
		};

		opp-792000000 {
			opp-hz = /bits/ 64 <792000000>;
			opp-microvolt = <900000 900000 1150000>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <960000 960000 1150000>;
		};

		opp-1224000000 {
			opp-hz = /bits/ 64 <1224000000>;
			opp-microvolt = <1050000 1050000 1150000>;
		};

		opp-1416000000 {
			opp-hz = /bits/ 64 <1416000000>;
			opp-microvolt = <1150000 1150000 1150000>;
		};
	};

	cluster1_opp: opp-table-cluster1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-480000000 {
			opp-hz = /bits/ 64 <480000000>;
			opp-microvolt = <900000>;
		};

		opp-1008000000 {
			opp-hz = /bits/ 64 <1008000000>;
			opp-microvolt = <900000>;
		};

		opp-1200000000 {
			opp-hz = /bits/ 64 <1200000000>;
			opp-microvolt = <920000>;
		};

		opp-1344000000 {
			opp-hz = /bits/ 64 <1344000000>;
			opp-microvolt = <960000>;
		};

		opp-1488000000 {
			opp-hz = /bits/ 64 <1488000000>;
			opp-microvolt = <1000000>;
		};

		opp-1584000000 {
			opp-hz = /bits/ 64 <1584000000>;
			opp-microvolt = <1050000>;
		};

		/*
		 * 1680/1800 MHz are fused off on vf05xx speed bins (their
		 * vendor-table entries are <0>: not allowed at any voltage).
		 * This board's chip reads bin vf0100 from the SID DVFS word
		 * (0x48 = 0x19 -> combi 0x01), which supports both. A generic
		 * image for unknown silicon must drop these two entries or
		 * gate them on the SID speed bin (sun50i-cpufreq-nvmem style).
		 */
		opp-1680000000 {
			opp-hz = /bits/ 64 <1680000000>;
			opp-microvolt = <1100000>;
		};

		opp-1800000000 {
			opp-hz = /bits/ 64 <1800000000>;
			opp-microvolt = <1150000>;
		};
	};

	/*
	 * GPU OPPs: the five speed-bin-independent points of the vendor
	 * table, plus 696 MHz, which the vendor table gates by SID speed
	 * bin: this board's chip reads dvfs efuse 0x19 (combi 0x01 -> GPU
	 * bin 1), for which the vendor sanctions 696 MHz at 0.90 V.
	 * The five common points divide exactly from the fixed pll-periph0
	 * outputs; 696 MHz instead needs pll-gpu as a live parent, so
	 * pll-gpu is pinned at 696 MHz via assigned-clock-rates below and
	 * only gets enabled while the 696 MHz OPP is selected.
	 *
	 * The vendor table asks for 0.90 V on every point; this board's
	 * vdd-gpu-sys rail (AXP717 DCDC2) is fixed at 0.92 V, so the OPPs
	 * state 0.92 V and voltage transitions are no-ops. The value cannot
	 * be dropped: the OPP core rejects a voltage-less table once
	 * panfrost attaches the mali-supply regulator.
	 */
	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-150000000 {
			opp-hz = /bits/ 64 <150000000>;
			opp-microvolt = <920000>;
		};

		opp-200000000 {
			opp-hz = /bits/ 64 <200000000>;
			opp-microvolt = <920000>;
		};

		opp-300000000 {
			opp-hz = /bits/ 64 <300000000>;
			opp-microvolt = <920000>;
		};

		opp-400000000 {
			opp-hz = /bits/ 64 <400000000>;
			opp-microvolt = <920000>;
		};

		opp-600000000 {
			opp-hz = /bits/ 64 <600000000>;
			opp-microvolt = <920000>;
		};

		opp-696000000 {
			opp-hz = /bits/ 64 <696000000>;
			opp-microvolt = <920000>;
		};
	};
};

/* Little cluster (cpu0-3): AXP717 DCDC1 (vdd-cpul), up to 1.416 GHz. */
&cpu0 {
	cpu-supply = <&reg_dcdc1>;
	operating-points-v2 = <&cluster0_opp>;
};

&cpu1 {
	cpu-supply = <&reg_dcdc1>;
	operating-points-v2 = <&cluster0_opp>;
};

&cpu2 {
	cpu-supply = <&reg_dcdc1>;
	operating-points-v2 = <&cluster0_opp>;
};

&cpu3 {
	cpu-supply = <&reg_dcdc1>;
	operating-points-v2 = <&cluster0_opp>;
};

/* Big cluster (cpu4-7): AXP323 DCDC1 (vdd-cpub), up to 1.8 GHz (bin vf0100). */
&cpu4 {
	cpu-supply = <&reg_dcdc1_323>;
	operating-points-v2 = <&cluster1_opp>;
};

&cpu5 {
	cpu-supply = <&reg_dcdc1_323>;
	operating-points-v2 = <&cluster1_opp>;
};

&cpu6 {
	cpu-supply = <&reg_dcdc1_323>;
	operating-points-v2 = <&cluster1_opp>;
};

&cpu7 {
	cpu-supply = <&reg_dcdc1_323>;
	operating-points-v2 = <&cluster1_opp>;
};

&ehci0 {
	status = "okay";
};

&ehci1 {
	status = "okay";
};

&gpu {
	mali-supply = <&reg_dcdc2>;
	operating-points-v2 = <&gpu_opp_table>;
	assigned-clocks = <&ccu CLK_PLL_GPU>;
	assigned-clock-rates = <696000000>;
	status = "okay";
};

&mmc0 {
	vmmc-supply = <&reg_cldo3>;
	cd-gpios = <&pio 5 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; /* PF6 */
	bus-width = <4>;
	status = "okay";
};

&mmc1 {
	bus-width = <4>;
	mmc-pwrseq = <&wifi_pwrseq>;
	non-removable;
	vmmc-supply = <&reg_dldo1_323>;
	vqmmc-supply = <&reg_bldo1>;
	status = "okay";

	brcmf: wifi@1 {
		compatible = "brcm,bcm4329-fmac";
		reg = <1>;
		interrupt-parent = <&r_pio>;
		interrupts = <1 0 IRQ_TYPE_LEVEL_LOW>; /* PM0 */
		interrupt-names = "host-wake";
	};
};

&mmc2 {
	bus-width = <8>;
	cap-mmc-hw-reset;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	non-removable;
	vmmc-supply = <&reg_cldo3>;
	vqmmc-supply = <&reg_cldo1>;
	status = "okay";
};

&ohci0 {
	status = "okay";
};

&ohci1 {
	status = "okay";
};

&pio {
	vcc-pb-supply = <&reg_cldo3>;	/* via VCC-IO */
	vcc-pc-supply = <&reg_cldo1>;
	vcc-pd-supply = <&reg_cldo3>;
	vcc-pe-supply = <&reg_aldo2>;
	vcc-pf-supply = <&reg_cldo3>;	/* VCC-IO for 3.3v; VCC-MCSI for 1.8v */
	vcc-pg-supply = <&reg_bldo1>;
	vcc-ph-supply = <&reg_cldo3>;	/* via VCC-IO */
	vcc-pi-supply = <&reg_cldo3>;
	vcc-pj-supply = <&reg_cldo1>;
	vcc-pk-supply = <&reg_cldo1>;
};

&r_ir {
	pinctrl-names = "default";
	pinctrl-0 = <&r_ir_rx_pin>;
	status = "okay";
};

&r_i2c0 {
	status = "okay";

	axp717: pmic@35 {
		compatible = "x-powers,axp717";
		reg = <0x35>;
		interrupt-controller;
		#interrupt-cells = <1>;
		interrupts-extended = <&nmi_intc 0 IRQ_TYPE_LEVEL_LOW>;

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;
		vin4-supply = <&reg_vcc5v>;
		aldoin-supply = <&reg_vcc5v>;
		bldoin-supply = <&reg_vcc5v>;
		cldoin-supply = <&reg_vcc5v>;

		axp717_adc: adc {
			compatible = "x-powers,axp717-adc";
			#io-channel-cells = <1>;
		};

		battery-power {
			compatible = "x-powers,axp717-battery-power-supply";
			/* no battery; output used for dcdc4 instead */
			status = "disabled";
		};

		regulators {
			/* Supplies the "little" cluster (1.4 GHz cores) */
			reg_dcdc1: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1160000>;
				regulator-name = "vdd-cpul";
			};

			reg_dcdc2: dcdc2 {
				regulator-always-on;
				regulator-min-microvolt = <920000>;
				regulator-max-microvolt = <920000>;
				regulator-name = "vdd-gpu-sys";
			};

			reg_dcdc3: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <1160000>;
				regulator-max-microvolt = <1160000>;
				regulator-name = "vcc-dram";
			};

			reg_dcdc4: dcdc4 {
				/* feeds 3.3V pin on GPIO header */
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vdd-io";
			};

			aldo1 {
				/* not actually connected */
				regulator-name = "avdd-csi";
			};

			reg_aldo2: aldo2 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-pe";
			};

			reg_aldo3: aldo3 {
				/* supplies the I2C pins for this PMIC */
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-pl-usb";
			};

			reg_aldo4: aldo4 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-pll-dxco-avcc";
			};

			reg_bldo1: bldo1 {
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-pg-wifi";
			};

			reg_bldo2: bldo2 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-pm-lpddr";
			};

			bldo3 {
				/* not actually connected */
				regulator-name = "afvcc-csi";
			};

			bldo4 {
				/* not actually connected */
				regulator-name = "dvdd-csi";
			};

			reg_cldo1: cldo1 {
				regulator-always-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
				regulator-name = "vcc-cvp-pc-lvds-mcsi-pk-efuse-pcie-edp-1v8";
			};

			reg_cldo2: cldo2 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc3v3-csi";
			};

			reg_cldo3: cldo3 {
				regulator-always-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-io-mmc-nand-pd-pi-usb";
			};

			reg_cldo4: cldo4 {
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-3v3-phy1-lcd";
			};

			reg_cpusldo: cpusldo {
				/* supplies the management core */
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdd-cpus-usb-0v9";
			};
		};

		usb-power {
			compatible = "x-powers,axp717-usb-power-supply";
			input-current-limit-microamp = <3000000>;
		};
	};

	axp323: pmic@36 {
		compatible = "x-powers,axp323";
		reg = <0x36>;
		#interrupt-cells = <1>;
		interrupt-controller;
		status = "okay";

		vin1-supply = <&reg_vcc5v>;
		vin2-supply = <&reg_vcc5v>;
		vin3-supply = <&reg_vcc5v>;

		regulators {
			reg_aldo1_323: aldo1 {
				/* less capable and shares load with dldo1 */
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-wifi";
			};

			reg_dldo1_323: dldo1 {
				/* more capable and shares load with aldo1 */
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-name = "vcc-wifi2";
			};

			/* Supplies the "big" cluster (1.8 GHz cores) */
			reg_dcdc1_323: dcdc1 {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <1150000>;
				regulator-name = "vdd-cpub";
			};

			/* DCDC2 is polyphased with DCDC1 */

			/* Some RISC-V management core related voltage */
			reg_dcdc3_323: dcdc3 {
				regulator-always-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
				regulator-name = "vdd-dnr";
			};
		};
	};
};

&r_pio {
/*
 * Specifying the supply would create a circular dependency.
 *
 *	vcc-pl-supply = <&reg_aldo3>;
 */
	vcc-pm-supply = <&reg_bldo2>;
};

&rtc {
	clocks = <&r_ccu CLK_BUS_R_RTC>, <&osc24M>,
		 <&r_ccu CLK_R_AHB>, <&ext_osc32k>;
	clock-names = "bus", "hosc", "ahb", "ext-osc32k";
	assigned-clocks = <&rtc CLK_OSC32K>;
	assigned-clock-rates = <32768>;
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pb_pins>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pins>, <&uart1_rts_cts_pins>;
	uart-has-rtscts;
	status = "okay";

	bluetooth {
		compatible = "brcm,bcm4345c5";
		clocks = <&rtc CLK_OSC32K_FANOUT>;
		clock-names = "lpo";
		vbat-supply = <&reg_aldo1_323>;
		vddio-supply = <&reg_bldo1>;
		device-wakeup-gpios = <&r_pio 1 3 GPIO_ACTIVE_HIGH>; /* PM3 */
		host-wakeup-gpios = <&r_pio 1 4 GPIO_ACTIVE_HIGH>; /* PM4 */
		shutdown-gpios = <&r_pio 1 2 GPIO_ACTIVE_HIGH>; /* PM2 */
	};
};

&combophy {
	resets = <&ccu RST_BUS_PCIE_USB3>;
	phy_use_sel = <0>; /* 0:PCIE; 1:USB3 */
	status = "okay";
};

&pcie {
	reset-gpios = <&pio 7 11 GPIO_ACTIVE_HIGH>; /* PH11, PERST# */
	wake-gpios = <&pio 7 12 GPIO_ACTIVE_HIGH>;  /* PH12, WAKE# */
	num-lanes = <1>;
	clk-freq-100M;
	pcie3v3-supply = <&reg_pcie_vcc3v3>;
	status = "okay";
};

&usb_otg {
	/*
	 * The OTG controller is connected to one of the type-A ports.
	 * There is a regulator, controlled by a GPIO, to provide VBUS power
	 * to the port, and a VBUSDET GPIO, to detect externally provided
	 * power. But without ID or CC pins there is no real way to do a
	 * runtime role detection.
	 */
	dr_mode = "host";
	status = "okay";
};

&usbphy {
	usb0_vbus-supply = <&reg_otg_vbus>;
	usb0_vbus_det-gpios = <&r_pio 0 7 GPIO_ACTIVE_HIGH>; /* PL7 */
	usb1_vbus-supply = <&reg_usb_vbus>;
	status = "okay";
};

&gmac1 {
	/* RGMII config validated live (2026-07-08) after fixing the
	 * withstand mode of bank PJ (1.8V rail, receiver in 3.3V mode = RX
	 * deaf; see a523_pio_fix_withstand in pinctrl-sun55i-a523.c).
	 * The PHY adds ~1.9ns of delay on RXC (rgmii-rxid + property in the
	 * PHY node); the MAC syscon only adds 100ps of TX (BSP: tx-delay=1).
	 * Resultado: 1Gbps/Full, ping 0% loss. */
	phy-mode = "rgmii-rxid";
	phy-handle = <&ext_rgmii_phy>;
	phy-supply = <&reg_cldo4>;
	tx-internal-delay-ps = <100>;
	rx-internal-delay-ps = <0>;
	status = "okay";
};

&mdio1 {
	ext_rgmii_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		/* RX clock delay in the YT8531 PHY itself (RXC_DLY_EN,
		 * ~1.9ns). The motorcomm driver reads this property FROM THE
		 * PHY NODE and only applies it with phy-mode rgmii-rxid/id. */
		rx-internal-delay-ps = <1900>;
		/* The BSP disables auto-sleep unconditionally. */
		motorcomm,auto-sleep-disabled;
		interrupts-extended = <&pio 8 16 IRQ_TYPE_LEVEL_LOW>; /* PI16 */
		reset-gpios = <&pio 8 15 GPIO_ACTIVE_LOW>; /* PI15 */
		reset-assert-us = <10000>;
		reset-deassert-us = <150000>;
	};
};

/*
 * ETAPA C display: pipeline KMS real (DE3.5 RCQ -> TCON-TV -> DW-HDMI+PHY Inno).
 * Adaptation of the minimyth2 2903 enable to this dts (which already has
 * reserved-memory with bl31+uboot_fb and the simpledrm boot framebuffer).
 */
/ {
	hdmi-connector {
		compatible = "hdmi-connector";
		type = "a";

		port {
			hdmi_con_in: endpoint {
				remote-endpoint = <&hdmi_out_con>;
			};
		};
	};
};

/*
 * The DE's DMA (scanout and RCQ pool) only reaches VERY low DRAM: the original
 * patch (X96Q, same die) notes that 0x43000000 is reachable but
 * 0x4b100000 is NOT. With the previous window (up to 0x70000000) the CMA landed
 * at 0x60000000 -> fetch outside the aperture -> interconnect hang
 * half-way through boot (boot 2, half-dead board). Strict window, like the
 * tested layout: 0x43000000-0x48000000 (after the kernel, before bl31),
 * 64MB (enough for the bring-up's dumb buffers/fbcon).
 */
&{/reserved-memory} {
	cma_low: linux,cma {
		compatible = "shared-dma-pool";
		reusable;
		size = <0x0 0x04000000>;
		alloc-ranges = <0x0 0x43000000 0x0 0x05000000>;
		linux,cma-default;
	};
};

/*
 * The DE's RCQ pool is allocated with dma_alloc_coherent on the
 * mixer device; being small it does not come from the global CMA and landed in high pages
 * outside the DE aperture (RCQ_HEAD 0x52100000 observed -> the RCQ DMA
 * read garbage and the datapath was never configured: green screen).
 * memory-region ties the mixer's coherent reservations to the low CMA
 * (sun55i_de calls of_reserved_mem_device_init if uses_rcq).
 */
&mixer0 {
	memory-region = <&cma_low>;
};

/*
 * DISPLAY BRING-UP: the display-engine (drm->dev) inherits IOMMU master 5
 * so that scanout GEMs and PRIME imports (kbase, not contiguous)
 * are allocated/mapped as translated IOVAs. It is the DT equivalent of
 * the BSP's of_dma_configure(drm->dev, DE_node) (sunxi_de.c:1262): with the
 * master 5 bypass removed ALL DE traffic is translated, so
 * an unmapped physical scanout would no longer show.
 */
&de {
	status = "okay";
	iommus = <&iommu 5>;
};

&hdmi {
	status = "okay";
};

&hdmi_out {
	hdmi_out_con: endpoint {
		remote-endpoint = <&hdmi_con_in>;
	};
};

/*
 * Changes from the audit against the 5.15 BSP:
 * - The BSP hangs vo0/tcon off the VO0 island (A523_PCK_VO0); the patch's
 *   dtsi only claims it from the hdmi node. Claiming it also in
 *   tcon-top and tcon-tv avoids touching registers with the island off and
 *   protects against the sync_state sweep (it already bit with simpledrm).
 * - The BSP sets CLK_DE to 600 MHz under PLL_VIDEO3_4X
 *   (assigned-clocks of the BSP's de@5000000 node); the patch's dtsi
 *   set no rate and the mux could stay on the reset parent.
 */
&tcon_top {
	power-domains = <&pck600 PD_VO0>;
};

&tcon_tv0 {
	power-domains = <&pck600 PD_VO0>;
};

&display_clocks {
	assigned-clocks = <&ccu CLK_DE>;
	assigned-clock-parents = <&ccu CLK_PLL_VIDEO3_4X>;
	assigned-clock-rates = <600000000>;
};

/*
 * DISPLAY BRING-UP: mixer iommus re-enabled (the dtsi already has
 * iommus = <&iommu 5>). The driver now carries the BSP's v15 recipe
 * (range invalidation + vendor prefetch) and diagnostic guards
 * against the corrupt DTE of the boot Oops.
 */

/*
 * HDMI AUDIO (the 5.15 BSP recipe): the BSP sends the audio
 * HDMI through I2S2 (i2s2_plat@7114000, dma1 req 5, card "sndhdmi",
 * i2s format, 2 slots of 32 bits, CPU master, no MCLK) to the
 * I2S input of the DW-HDMI (internal SoC wiring, no pinctrl). In mainline the
 * equivalent is sun4i-i2s (r329 fallback, same register layout) +
 * dw-hdmi-i2s-audio (the core already registers the codec: CONFIG3 has GPAUD,
 * verified live) + simple-audio-card, rk3328 pattern. The i2s2 and
 * mcu_dma nodes are upstream master's (Chen-Yu Tsai's A523 I2S series),
 * except dma-channels=8, which is what the BSP dts says (upstream has 16).
 * mclk-fs=128: the DW-HDMI does not consume MCLK but sun4i-i2s derives from it the
 * BCLK dividers.
 */
&i2s2 {
	status = "okay";
};

/ {
	hdmi_sound: hdmi-sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "sndhdmi";
		simple-audio-card,format = "i2s";
		simple-audio-card,mclk-fs = <128>;

		/*
		 * ALWAYS 32-bit slots (like the BSP: soundcard-mach,
		 * slot-width = <32>): dw-hdmi-i2s-audio hardcodea
		 * AUD_INPUTCLKFS=64fs, and without this, with S16, sun4i-i2s
		 * generates 32fs frames (16-bit slot) -> the DW-HDMI samples
		 * the frame wrongly and the sink receives SILENCE (verified on the
		 * board: S32 played, S16 did not; TXCNT advanced in both).
		 */
		simple-audio-card,cpu {
			sound-dai = <&i2s2>;
			dai-tdm-slot-num = <2>;
			dai-tdm-slot-width = <32>;
		};

		simple-audio-card,codec {
			sound-dai = <&hdmi>;
		};
	};
};

/*
 * ANALOG AUDIO (A523 internal codec, the 5.15 BSP recipe): 3.5 mm
 * jack (HPOUT + jack detect on IRQ 190), line-out, 3 mic inputs and an
 * external speaker amplifier on PH6 (active high, no delay, BSP node
 * pa-pin-0). The regulators are those of the &codec node in the board's BSP
 * dts: avcc=aldo4 1.8V, vdd=cldo3 3.3V, cpvin=cldo1 1.8V (HP charge
 * pump). The board's gains/volumes == the BSP driver defaults, so they are
 * hard-wired in the driver. jack-det-level=1 and threshold=8 are the mainline
 * driver defaults, no need to declare them.
 */
&codec {
	avcc-supply = <&reg_aldo4>;
	vdd-supply = <&reg_cldo3>;
	cpvin-supply = <&reg_cldo1>;
	allwinner,pa-gpios = <&pio 7 6 GPIO_ACTIVE_HIGH>; /* PH6 */
	status = "okay";
};
