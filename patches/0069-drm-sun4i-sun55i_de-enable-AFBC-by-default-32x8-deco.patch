From 169f981228f93c879fc3d60cdb29d1a693cc5153 Mon Sep 17 00:00:00 2001
From: Juan Manuel Lopez Carrillo <juanmanuellopezcarrillo@gmail.com>
Date: Sun, 12 Jul 2026 15:26:26 +0200
Subject: [PATCH 069/130] drm/sun4i: sun55i_de: enable AFBC by default (32x8
 decode confirmed)

Visually confirmed (user, 2026-07-12): perfect Plasma Wayland desktop with
kwin scanning ARGB8888 in 32x8|SPARSE|YTR|SPLIT via the AFBD. AFBC is enabled
by default; afbc=0 forces linear scanout if needed.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 drivers/gpu/drm/sun4i/sun55i_de.c | 15 ++++++++-------
 1 file changed, 8 insertions(+), 7 deletions(-)

diff --git a/drivers/gpu/drm/sun4i/sun55i_de.c b/drivers/gpu/drm/sun4i/sun55i_de.c
index bf746cf4e..9bacff5b4 100644
--- a/drivers/gpu/drm/sun4i/sun55i_de.c
+++ b/drivers/gpu/drm/sun4i/sun55i_de.c
@@ -996,15 +996,16 @@ static int sun55i_de_afbc_fmt_seq(u32 drm_fmt, u32 *seq)
 }
 
 /*
- * AFBC scanout via the AFBD: the block programming is verified by
- * registers, but the DECODE of real content comes out wrong (2026-07-12,
- * kwin: AFBC = black/squares, LINEAR = perfect desktop - same kernel).
- * Off by default until the semantics are debugged against the BSP;
- * re-enable with sun8i-mixer afbc=1 for debug sessions.
+ * AFBC scanout via the AFBD: the DE decodes compressed RGB8888 in the
+ * vendor mode 32x8|SPARSE|YTR|SPLIT (block_layout=3). VISUALLY CONFIRMED
+ * 2026-07-12: perfect Plasma desktop with kwin scanning AR24 in that
+ * modifier (before, in 16x16, it came out black/squares: 16x16 RGB is a
+ * mode this AFBD does not decode). On by default; afbc=0 disables it
+ * (forces linear scanout) if needed.
  */
-bool sun55i_afbc_enable;
+bool sun55i_afbc_enable = true;
 module_param_named(afbc, sun55i_afbc_enable, bool, 0444);
-MODULE_PARM_DESC(afbc, "advertise AFBC modifiers (AFBD decode under debug)");
+MODULE_PARM_DESC(afbc, "advertise AFBC modifiers (AFBD-compressed scanout)");
 
 bool sun55i_de_afbc_mod_supported(u32 drm_fmt, u64 modifier)
 {
