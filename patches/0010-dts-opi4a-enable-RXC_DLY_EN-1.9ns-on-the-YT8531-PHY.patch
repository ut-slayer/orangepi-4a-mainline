From 7b1b3ce61fca49366c635ce55e7f90b179d8c55b Mon Sep 17 00:00:00 2001
From: Juan Manuel Lopez Carrillo <juanmanuellopezcarrillo@gmail.com>
Date: Wed, 8 Jul 2026 01:56:42 +0200
Subject: [PATCH 010/130] dts: opi4a: enable RXC_DLY_EN (1.9ns) on the YT8531
 PHY

The PHY delay is requested ON THE PHY NODE (motorcomm reads it from there),
not on the MAC one. rx-internal-delay-ps=1900 falls in the 2nd half of the
ytphy_rgmii_delays table -> turns on the RXC_DLY_EN base bit (~1.9ns of RX
clock delay). Without it, mainline leaves RXC undelayed and rx_packets=0.
The BSP 5.15 keeps that bit on by default, which is why its network works
directly.
---
 arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
index 48dad8056..cdc678c37 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
@@ -509,6 +509,12 @@ &mdio1 {
 	ext_rgmii_phy: ethernet-phy@1 {
 		compatible = "ethernet-phy-ieee802.3-c22";
 		reg = <1>;
+		/* Turn on the RX clock delay (RXC_DLY_EN, ~1.9ns) in the
+		 * YT8531 PHY itself. The motorcomm driver reads this property
+		 * FROM THE PHY NODE; the value 1900 falls in the 2nd half of
+		 * the ytphy_rgmii_delays table -> enables the 1.9ns base bit.
+		 * Without it, rgmii/rgmii-rxid leave RXC undelayed, rx_packets=0. */
+		rx-internal-delay-ps = <1900>;
 		interrupts-extended = <&pio 8 16 IRQ_TYPE_LEVEL_LOW>; /* PI16 */
 		reset-gpios = <&pio 8 15 GPIO_ACTIVE_LOW>; /* PI15 */
 		reset-assert-us = <10000>;
