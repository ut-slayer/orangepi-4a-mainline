 }
diff --git a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
index 619979fa5..9f1f8889d 100644
--- a/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
+++ b/drivers/gpu/drm/sun4i/sun8i_ui_layer.c
@@ -384,6 +384,32 @@ static int sun55i_primary_atomic_check(struct drm_plane *plane,
 	return 0;
 }
 
+/*
+ * atomic_check of the v35x cursor: its own channel (phys 7) on its blender
+ * pipe, independent of the primary (it also works with an AFBC
+ * primary). Unscaled only: the channel's VSU is permanently bypassed.
+ */
+static int sun55i_cursor_atomic_check(struct drm_plane *plane,
+				      struct drm_atomic_state *state)
+{
+	struct drm_plane_state *new_state = drm_atomic_get_new_plane_state(state,
+									   plane);
+	struct drm_crtc *crtc = new_state->crtc;
+	struct drm_crtc_state *crtc_state;
+
+	if (!crtc)
+		return 0;
+
+	crtc_state = drm_atomic_get_existing_crtc_state(state, crtc);
+	if (WARN_ON(!crtc_state))
+		return -EINVAL;
+
+	return drm_atomic_helper_check_plane_state(new_state, crtc_state,
+						   DRM_PLANE_NO_SCALING,
+						   DRM_PLANE_NO_SCALING,
+						   true, true);
+}
+
 static const struct drm_plane_helper_funcs sun55i_primary_helper_funcs = {
 	.atomic_check	= sun55i_primary_atomic_check,
 	.atomic_update	= sun8i_ui_layer_atomic_update,
@@ -394,6 +420,11 @@ static const struct drm_plane_helper_funcs sun55i_overlay_helper_funcs = {
 	.atomic_update	= sun8i_ui_layer_atomic_update,
 };
 
+static const struct drm_plane_helper_funcs sun55i_cursor_helper_funcs = {
+	.atomic_check	= sun55i_cursor_atomic_check,
+	.atomic_update	= sun8i_ui_layer_atomic_update,
+};
+
 /*
  * v35x: the primary UI channel has an AFBC decoder (AFBD). LINEAR works
  * for everything; AFBC only in the combinations sun55i_de decodes.
@@ -464,12 +495,34 @@ static const uint64_t sun55i_layer_modifiers[] = {
 };
 
 /*
- * Formats of the v35x overlay planes: exactly the ones sun55i_de_fmt
- * programs in the OVL fetch (the primary inherits the generic DE2 table
- * for compatibility, but an overlay advertising 4444/1555 would end up as a
- * disabled layer + a screen silently missing the overlay).
+ * Formats of the v35x LAY1..3 overlay planes: opaque formats ONLY.
+ * VERIFIED ON THE BOARD 2026-07-21 (modetest, SMPTE primary + LAY1 AR24
+ * plain 0x77777777): intra-channel OVL stacking is by rectangle
+ * priority (LAY_n covers LAY_(n-1)), with NO per-pixel alpha mixing between
+ * layers - the translucent grey came out opaque despite combined alpha_mode +
+ * staged premul. Advertising ARGB here would invite the compositor to hand over
+ * translucent content that would show up opaque; real alpha lives in the
+ * Porter-Duff blend BETWEEN the blender pipes (the cursor plane, channel
+ * phys 7). Also, only formats that sun55i_de_fmt programs (advertising
+ * 4444/1555 like the primary would end up as a silently disabled layer).
  */
 static const u32 sun55i_ovl_formats[] = {
+	DRM_FORMAT_XRGB8888,
+	DRM_FORMAT_XBGR8888,
+	DRM_FORMAT_RGBX8888,
+	DRM_FORMAT_BGRX8888,
+	DRM_FORMAT_RGB888,
+	DRM_FORMAT_BGR888,
+	DRM_FORMAT_RGB565,
+	DRM_FORMAT_BGR565,
+};
+
+/*
+ * Formats of the v35x cursor plane (channel phys 7, blender pipe 1): here
+ * alpha IS real - applied by the pipe's SRCOVER blend_ctl, not the
+ * OVL - so the formats with alpha are advertised too.
+ */
+static const u32 sun55i_cursor_formats[] = {
 	DRM_FORMAT_ARGB8888,
 	DRM_FORMAT_ABGR8888,
 	DRM_FORMAT_RGBA8888,
@@ -485,10 +538,12 @@ static const u32 sun55i_ovl_formats[] = {
 };
 
 /*
- * v35x overlay/cursor plane: a layer LAY1..3 of the primary's UI channel
- * (phys 6), LINEAR only and unscaled (see sun55i_overlay_atomic_check).
- * Immutable zpos: the intra-channel stacking order is fixed by the hardware layer
- * index, it cannot be reordered on the fly.
+ * v35x overlay/cursor plane. type OVERLAY = a layer LAY1..3 of the primary's UI
+ * channel (phys 6): LINEAR only, unscaled, opaque stacking by
+ * priority (see sun55i_overlay_atomic_check). type CURSOR = layer 0 of the
+ * channel phys 7 on blender pipe 1: real alpha through SRCOVER,
+ * independent of the primary (survives AFBC). Immutable zpos: the
+ * stacking (layer index / pipe order) is fixed in hardware.
  */
 struct sun8i_layer *sun55i_ui_overlay_init(struct drm_device *drm,
 					   struct sun8i_mixer *mixer,
@@ -496,6 +551,7 @@ struct sun8i_layer *sun55i_ui_overlay_init(struct drm_device *drm,
 					   int channel, int overlay,
 					   unsigned int zpos)
 {
+	bool cursor = type == DRM_PLANE_TYPE_CURSOR;
 	struct sun8i_layer *layer;
 	int ret;
 
@@ -508,8 +564,10 @@ struct sun8i_layer *sun55i_ui_overlay_init(struct drm_device *drm,
 
 	ret = drm_universal_plane_init(drm, &layer->plane, 0,
 				       &sun8i_ui_layer_funcs,
-				       sun55i_ovl_formats,
-				       ARRAY_SIZE(sun55i_ovl_formats),
+				       cursor ? sun55i_cursor_formats :
+						sun55i_ovl_formats,
+				       cursor ? ARRAY_SIZE(sun55i_cursor_formats) :
+						ARRAY_SIZE(sun55i_ovl_formats),
 				       sun8i_layer_modifiers, type, NULL);
 	if (ret) {
 		dev_err(drm->dev, "Couldn't initialize overlay plane\n");
@@ -528,7 +586,9 @@ struct sun8i_layer *sun55i_ui_overlay_init(struct drm_device *drm,
 		return ERR_PTR(ret);
 	}
 
-	drm_plane_helper_add(&layer->plane, &sun55i_overlay_helper_funcs);
+	drm_plane_helper_add(&layer->plane, cursor ?
+			     &sun55i_cursor_helper_funcs :
+			     &sun55i_overlay_helper_funcs);
 	layer->type = SUN8I_LAYER_TYPE_UI;
 	layer->channel = channel;
 	layer->overlay = overlay;
