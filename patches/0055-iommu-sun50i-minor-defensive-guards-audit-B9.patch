Date: Mon, 13 Jul 2026 14:51:29 +0200
Subject: [PATCH 055/143] iommu/sun50i: minor defensive guards (audit B9)

- iotlb_sync_map: !iommu guard (a freshly created paging domain never
  attached -> iommu_map() dereferenced NULL in the spinlock; the twin guard
  already existed in flush_iotlb_all).
- map: restore the -EINVAL for paddr outside the foldable window
  [DRAM_BASE, +4G) (the vanilla 'beyond 4GB' guard was lost with the fold;
  out of range it was stored with a silent alias).
- detach_domain: flush TLB/PTW BEFORE freeing the page tables (a hot walker
  could re-read a freed PT: DMA UAF; the BSP never frees PTs at runtime, the
  window is mainline-specific).
- handle_pt_irq: ilog2(0) is undefined if blame carries no INT_MASTER_MASK
  bit (e.g. master 6/DI) - clamp to 0.
---
 drivers/iommu/sun50i-iommu.c | 36 +++++++++++++++++++++++++++++++++++-
 1 file changed, 35 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/sun50i-iommu.c b/drivers/iommu/sun50i-iommu.c
index 605aa9cf8..49ecab7e2 100644
--- a/drivers/iommu/sun50i-iommu.c
+++ b/drivers/iommu/sun50i-iommu.c
@@ -548,6 +548,12 @@ static int sun50i_iommu_iotlb_sync_map(struct iommu_domain *domain,
 	struct sun50i_iommu *iommu = sun50i_domain->iommu;
 	unsigned long flags;
 
+	/* freshly created domain that was never attached: iommu still NULL (as in
+	 * flush_iotlb_all; without this guard, iommu_map() on that domain
+	 * dereferences NULL in the spinlock) */
+	if (!iommu)
+		return 0;
+
 	spin_lock_irqsave(&iommu->iommu_lock, flags);
 	sun50i_iommu_zap_range(iommu, iova, size);
 	spin_unlock_irqrestore(&iommu->iommu_lock, flags);
@@ -766,6 +772,20 @@ static int sun50i_iommu_map(struct iommu_domain *domain, unsigned long iova,
 	u32 *page_table, *pte_addr;
 	int ret = 0;
 
+	/*
+	 * The PTE fold only represents [DRAM_BASE, DRAM_BASE+4G): a
+	 * paddr outside it (MMIO <1G, or >5G on a future SoC) would be stored as a
+	 * silent alias. No such paddr exists on the T527; the guard is
+	 * defensive (it replaces vanilla's 'beyond 4GB' -EINVAL).
+	 */
+	if (paddr < SUN50I_IOMMU_DRAM_BASE ||
+	    paddr - SUN50I_IOMMU_DRAM_BASE >= SZ_4G) {
+		dev_err_once(iommu->dev,
+			     "paddr %pa outside the PTE fold window\n",
+			     &paddr);
+		return -EINVAL;
+	}
+
 	page_table = sun50i_dte_get_page_table(sun50i_domain, iova, gfp);
 	if (IS_ERR(page_table)) {
 		ret = PTR_ERR(page_table);
@@ -897,8 +917,19 @@ static int sun50i_iommu_attach_domain(struct sun50i_iommu *iommu,
 static void sun50i_iommu_detach_domain(struct sun50i_iommu *iommu,
 				       struct sun50i_iommu_domain *sun50i_domain)
 {
+	unsigned long flags;
 	unsigned int i;
 
+	/*
+	 * Invalidate TLB/PTW BEFORE freeing the tables: a walker with a
+	 * hot macro-TLB/PTW could read back an already freed PT (a DMA
+	 * use-after-free) in the window until the final disable. The BSP never frees
+	 * PTs at runtime, so this window only exists in mainline.
+	 */
+	spin_lock_irqsave(&iommu->iommu_lock, flags);
+	sun50i_iommu_flush_all_tlb(iommu);
+	spin_unlock_irqrestore(&iommu->iommu_lock, flags);
+
 	for (i = 0; i < NUM_DT_ENTRIES; i++) {
 		u32 *page_table;
 		u32 *dte_addr;
@@ -1052,7 +1083,10 @@ static phys_addr_t sun50i_iommu_handle_pt_irq(struct sun50i_iommu *iommu,
 
 	iova = iommu_read(iommu, addr_reg);
 	blame = iommu_read(iommu, blame_reg);
-	master = ilog2(blame & IOMMU_INT_MASTER_MASK);
+	/* blame with no known bit (e.g. master 6/DI, outside INT_MASTER_MASK
+	 * in the BSP's INT_ENABLE): ilog2(0) is undefined - clamp to 0 */
+	blame &= IOMMU_INT_MASTER_MASK;
+	master = blame ? ilog2(blame) : 0;
 
 	/*
 	 * If the address is not in the page table, we can't get what
