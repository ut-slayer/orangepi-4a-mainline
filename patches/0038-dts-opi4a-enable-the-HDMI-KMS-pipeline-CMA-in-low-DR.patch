From 4cf691ba7fa85204f8ae144f011d53b2e1279b08 Mon Sep 17 00:00:00 2001
From: Juan Manuel Lopez Carrillo <juanmanuellopezcarrillo@gmail.com>
Date: Wed, 8 Jul 2026 18:09:42 +0200
Subject: [PATCH 038/130] dts: opi4a: enable the HDMI KMS pipeline + CMA in
 low DRAM

Enable of &de/&hdmi + hdmi-connector (adapted from minimyth2 2903, which
also covers the OPi 4A) merged by hand with our local dts (reserved-memory
bl31+uboot_fb and the stage-A simple-framebuffer). 256MB CMA with explicit
alloc-ranges in low DRAM: the DE DMA does not reach high addresses and the
CMA here landed at ~0xb9e00000.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 .../dts/allwinner/sun55i-t527-orangepi-4a.dts | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
index ed13857b3..98aca4c7f 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
@@ -572,3 +572,51 @@ ext_rgmii_phy: ethernet-phy@1 {
 		reset-deassert-us = <150000>;
 	};
 };
+
+/*
+ * Display stage C: real KMS pipeline (DE3.5 RCQ -> TCON-TV -> DW-HDMI+Inno PHY).
+ * Adapted the minimyth2 2903 enable to this dts (which already has
+ * reserved-memory with bl31+uboot_fb and the boot simpledrm framebuffer).
+ */
+/ {
+	hdmi-connector {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+};
+
+/*
+ * The DE DMA (scanout and RCQ pool) only reaches low DRAM; the default CMA
+ * lands high (~0xb9e00000 here) and scanout would read zeros (black).
+ * Explicit alloc-ranges to force it low (the original patch relied on the
+ * default placement on its own board).
+ */
+&{/reserved-memory} {
+	linux,cma {
+		compatible = "shared-dma-pool";
+		reusable;
+		size = <0x0 0x10000000>;
+		alloc-ranges = <0x0 0x40000000 0x0 0x30000000>;
+		linux,cma-default;
+	};
+};
+
+&de {
+	status = "okay";
+};
+
+&hdmi {
+	status = "okay";
+};
+
+&hdmi_out {
+	hdmi_out_con: endpoint {
+		remote-endpoint = <&hdmi_con_in>;
+	};
+};
