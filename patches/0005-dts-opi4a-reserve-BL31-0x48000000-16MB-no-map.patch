From 2281838e87ac7565dac037441668c790cf24d626 Mon Sep 17 00:00:00 2001
From: Juan Manuel Lopez Carrillo <juanmanuellopezcarrillo@gmail.com>
Date: Tue, 23 Jun 2026 12:57:24 +0200
Subject: [PATCH 005/130] dts: opi4a: reserve BL31 @0x48000000 (16MB no-map)

The BSP reserves that region for BL31 (ATF, the EL3/PSCI monitor). The
mainline DTB reserved nothing and its /memory(2GB) covers it -> the kernel
uses it as RAM and clobbers BL31 -> after the 1st heartbeat, a PSCI call
lands in corrupt code -> hang with the LED stuck. Reserving it (like the
BSP) avoids it.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../dts/allwinner/sun55i-t527-orangepi-4a.dts | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
index e81adbc17..6e07f2726 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
+++ b/arch/arm64/boot/dts/allwinner/sun55i-t527-orangepi-4a.dts
@@ -35,6 +35,29 @@ memory@40000000 {
 		reg = <0x0 0x40000000 0x0 0x80000000>;
 	};
 
+	/*
+	 * The BSP 5.15 reserves this region for BL31 (ARM Trusted Firmware),
+	 * the secure EL3 monitor that services ALL PSCI calls (SMP core
+	 * bring-up, idle, reset). The mainline DTB reserved nothing and its
+	 * /memory (2GB from 0x40000000) covers 0x48000000 -> the kernel sees
+	 * those 16 MB as free RAM, allocates pages there and CLOBBERS BL31.
+	 * SMP comes up before the heartbeat (BL31 still intact) -> 1 beat;
+	 * just after, a PSCI call lands in corrupt code -> hang with the LED
+	 * stuck. Reserving the region (like the BSP) avoids it. no-map = the
+	 * kernel does not even map it. The v2018 U-Boot BSP does not inject
+	 * this reserve into a foreign DTB, so it has to be static here.
+	 */
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		bl31@48000000 {
+			reg = <0x0 0x48000000 0x0 0x01000000>;
+			no-map;
+		};
+	};
+
 	/*
 	 * Stub nodes for the U-Boot BSP (v2018.05-t527): its bootm calls
 	 * sunxi_drm_kernel_para_flush(), which looks up /soc/sunxi-drm and
