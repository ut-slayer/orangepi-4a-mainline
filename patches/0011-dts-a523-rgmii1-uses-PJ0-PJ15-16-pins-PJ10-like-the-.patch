From 4d60a01beb6a059fda0362cf3c4efedec061287e Mon Sep 17 00:00:00 2001
From: Juan Manuel Lopez Carrillo <juanmanuellopezcarrillo@gmail.com>
Date: Wed, 8 Jul 2026 02:05:52 +0200
Subject: [PATCH 011/130] dts: a523: rgmii1 uses PJ0-PJ15 (16 pins, +PJ10
 like the BSP)

Mainline skipped PJ10; the OPi4A BSP maps the full PJ0..PJ15 to gmac1.
With PJ10 unmapped one RX signal was left out -> rx_packets=0 despite a
1Gbps link and working TX. Four delay changes did not move the RX (0
crc_errors = no clock arriving), so the culprit is structural: the missing
pin.
---
 arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
index f1648c0c6..e9e22edb6 100644
--- a/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
+++ b/arch/arm64/boot/dts/allwinner/sun55i-a523.dtsi
@@ -183,9 +183,13 @@ rgmii0_pins: rgmii0-pins {
 			};
 
 			rgmii1_pins: rgmii1-pins {
+				/* The OPi4A uses PJ0..PJ15 (16 pins, like the BSP);
+				 * mainline skipped PJ10, leaving one RX signal
+				 * unmapped -> rx_packets=0. */
 				pins = "PJ0", "PJ1", "PJ2", "PJ3", "PJ4",
 				       "PJ5", "PJ6", "PJ7", "PJ8", "PJ9",
-				       "PJ11", "PJ12", "PJ13", "PJ14", "PJ15";
+				       "PJ10", "PJ11", "PJ12", "PJ13", "PJ14",
+				       "PJ15";
 				allwinner,pinmux = <5>;
 				function = "gmac1";
 				drive-strength = <40>;
